# ════════════════════════════════════════════════════════════════
# §1.2 SECURITY: Never commit a real SECRET_KEY.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The value below is the default placeholder — must be changed before production.
# ════════════════════════════════════════════════════════════════
# Database (Default: SQLite local zero-setup)
DATABASE_URL=sqlite+aiosqlite:///./kabadiwala.db

# Security & Tokens
# §1.2: MUST be overridden before deploying to production!
SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=development

# CORS additional origins (space-separated)
CORS_ORIGINS_EXTRA=

# ========================================================================
# REAL SMS GATEWAY CREDENTIALS
# Configure ANY ONE of the following to send live carrier SMS to real phones:
# ========================================================================

# OPTION 1: Fast2SMS (Recommended for India — instant free credits upon signup)
# 1. Sign up at https://www.fast2sms.com (takes 30 seconds with your mobile)
# 2. Copy your API Authorization Key from Dev API tab
FAST2SMS_API_KEY=

# OPTION 2: 2Factor.in (India OTP Gateway — instant free test credits)
# 1. Sign up at https://2factor.in
# 2. Copy your API key
TWOFACTOR_API_KEY=

# OPTION 3: Twilio (Global & India)
# 1. Get credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OPTION 3: MSG91 (Enterprise India)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
